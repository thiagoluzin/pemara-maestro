# Maestro Pro - exemplo sem segredos
MAESTRO_FRONTEND_PORT=9501
MAESTRO_STUDIO_PORT=8029

# URLs oficiais do Maestro
MAESTRO_PUBLIC_URL=https://maestro.pemaratech.com.br/
MAESTRO_LOCAL_URL=http://127.0.0.1:9501/
# Hostnames privados adicionais aceitos pelo gateway, separados por virgula.
MAESTRO_PRIVATE_GATEWAY_HOSTS=pc-geral-thiago-1.tail14cf8c.ts.net

# Login web em https://maestro.pemaratech.com.br/
MAESTRO_ADMIN_USER=admin
# Preferido: senha em branco e hash scrypt gerado durante a instalacao/migracao.
MAESTRO_ADMIN_PASSWORD=
MAESTRO_ADMIN_PASSWORD_HASH=scrypt$32768$8$1$SALT_BASE64$HASH_BASE64
MAESTRO_SESSION_MAX_AGE=2592000
MAESTRO_MAX_PROXY_BYTES=8589934592

# Ditado acessivel: processamento local por Faster Whisper, sem nuvem e sem guardar audio.
MAESTRO_DICTATION_MAX_BYTES=16777216
MAESTRO_DICTATION_MAX_SECONDS=120
MAESTRO_EDITOR_WHISPER_SIZE=base

# Segredos internos do proxy. Nunca enviar ao navegador ou colocar na URL.
MAESTRO_FRONTEND_TOKEN=trocar_por_token_forte
STUDIO_INTERNAL_TOKEN=trocar_por_outro_token_forte

# O painel e as interfaces de proprietario passam pelo gateway autenticado.
# As portas reais dos motores continuam locais, por isso IS_PUBLIC permanece false.
SPRUNKI_IS_PUBLIC=false
SPRUNKI_PUBLIC_URL=https://sprunki.pemaratech.com.br/
SPRUNKI_LOCAL_URL=http://127.0.0.1:5005/
SPRUNKI_PORT=5005

COMFY_IS_PUBLIC=false
COMFY_PUBLIC_URL=https://comfy.pemaratech.com.br/
COMFY_LOCAL_URL=http://127.0.0.1:8188/
COMFY_PORT=8188

STUDIO_IS_PUBLIC=false
STUDIO_PUBLIC_URL=
STUDIO_LOCAL_URL=http://127.0.0.1:8029/
STUDIO_PORT=8029

PERPLEXICA_IS_PUBLIC=false
PERPLEXICA_PUBLIC_URL=https://perplexica.pemaratech.com.br/
PERPLEXICA_LOCAL_URL=http://127.0.0.1:3002/
PERPLEXICA_PORT=3002

API_CAD_LOCAL_URL=http://127.0.0.1:8001/
API_DOC_LOCAL_URL=http://127.0.0.1:8002/
API_HIST_LOCAL_URL=http://127.0.0.1:8004/
API_ORG_LOCAL_URL=http://127.0.0.1:8006/
API_DASH_LOCAL_URL=http://127.0.0.1:8007/

# NVIDIA NIM / Build API - LLM externo para acelerar planejamento, prompts e auditoria.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_REASONING_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# Editor IA local
OLLAMA_HOST=http://127.0.0.1:11435
MAESTRO_EDITOR_LLM_MODEL=qwen3.5:4b
# ElevenLabs cloud e opcional; permanece desligado sem uma acao/configuracao explicita.
MAESTRO_VOICE_CLOUD_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_v3
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
# Ambiente opcional criado por ferramentas/chatterbox/INSTALAR_CHATTERBOX.ps1
MAESTRO_CHATTERBOX_PYTHON=
MAESTRO_CHATTERBOX_DEVICE=cuda
MAESTRO_NEURAL_CACHE=C:\PemaraAI\model-cache

# Musica neural local. O runtime fica em loopback, inicia sob demanda e gera somente
# pilotos de 5 a 15 segundos ate a escuta humana do proprietario.
LEVO2_ENABLED=true
LEVO2_PORT=8190
LEVO2_MIN_FREE_VRAM_MB=20000
VIDEO_SOUND_HUNYUAN_MODEL_ROOT=G:\Pemara_AI_Models\HunyuanVideo-Foley
VIDEO_SOUND_HUNYUAN_DOCKER_IMAGE=pemara/hunyuanvideo-foley:cuda128
VIDEO_SOUND_GPU_ID=0
VIDEO_SOUND_MIN_FREE_VRAM_MB=24000
VIDEO_SOUND_COMFY_QUEUE_URL=http://127.0.0.1:8188/queue

# Modo render: antes de enviar um take, mede o host, descarrega modelos Ollama
# e encerra somente runtimes ComfyUI secundarios conhecidos e ociosos.
MAESTRO_RENDER_FOCUS_ENABLED=true
MAESTRO_RENDER_FOCUS_SECONDARY_COMFY_PORTS=8190
MAESTRO_RENDER_FOCUS_UNLOAD_OLLAMA=true
MAESTRO_RENDER_FOCUS_MIN_FREE_RAM_GB=16

# MOVA-720p oficial: runtime isolado do ComfyUI e pesos no volume de modelos.
# O Studio so libera inferencia quando detectar pelo menos 112 GiB (maquina com 128 GB).
MAESTRO_MOVA_MODEL_DIR=D:\PemaraModels\mova\MOVA-720p
MAESTRO_MOVA_SOURCE_DIR=E:\Pemara\third_party\MOVA
MAESTRO_MOVA_ENGINE_ROOT=E:\Pemara\maestro\pemara\ferramentas\video_global_engine\engines\mova
MAESTRO_MOVA_PYTHON=E:\Pemara\maestro\pemara\ferramentas\video_global_engine\engines\mova\.venv\Scripts\python.exe
MAESTRO_MOVA_RUNNER=E:\Pemara\maestro\pemara\ferramentas\video_global_engine\engines\mova\maestro_mova_runner.py
