{
  "name": "@pemara/maestro-hyperframes",
  "version": "0.1.0",
  "private": true,
  "description": "Renderizador HyperFrames local e isolado do Maestro Video Global Engine.",
  "type": "module",
  "scripts": {
    "doctor": "hyperframes doctor --json",
    "preview:pilot": "hyperframes preview projects/maestro-pilot --port 8032 --no-browser-gpu",
    "lint:pilot": "hyperframes lint projects/maestro-pilot --json",
    "check:pilot": "hyperframes check projects/maestro-pilot --snapshots --no-browser-gpu --json",
    "render:pilot": "hyperframes render projects/maestro-pilot --output projects/maestro-pilot/renders/maestro-hyperframes-pilot.mp4 --fps 30 --quality high --workers 1 --no-browser-gpu --strict"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "gsap": "3.14.2",
    "hyperframes": "0.7.103"
  }
}
